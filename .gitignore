# Python bytecode / build metadata
__pycache__/
*.py[cod]
*.egg-info/

# Incomplete downloads
*.part

# Built HF datasets (regenerable from analysis/*subset*.json)
/crossview_dataset/
*.tmp/
*.tmp

# Generated converter output: pre-subset master pools (regenerable via
# convert_crossview.py in <1s). The eval *subset* json files are tracked; these
# *_qa.json pools are not.
/analysis/crossview_*_qa.json

# AgiBot HF tar-tree cache (regenerated by fetch_agibot_videos.py)
/analysis/.agibot_tree_cache.json

# Large fetched media & external release data — licensed/regenerable, do not commit
/crossview-release-annotations/

# Regenerable analysis outputs, logs, media (rebuilt by analyze_failures.py /
# curate_failure_examples.py from the tracked eval JSONs)
/analysis/logs/

# Regenerable slide decks (binary) + eval-rerun contamination backups
*.pptx
*.contaminated*.bak

# Benchmark run outputs (regenerable via bench/run_bench.py)
/bench/results/

# Claude Code local config / runtime (per-user, not shared)
/.claude/

# eval output dumps — regenerable, outputs never in git (files stay on disk)
/Video-R1/src/r1-v/eval_results/
/lmms-eval/res/
/lmms-eval/logs/
/data/

# Regenerable deck/doc artifacts (rebuilt by make_slide_figs.py / make_repq_doc.py /
# clip_selection_diagnostic.py from tracked scripts + result rows; files stay on disk)
/analysis/figs_deck/
/analysis/repq_doc.html
/analysis/repq_doc.md
/analysis/repq_doc_manifest.json
/analysis/repq_doc_slack.txt
/analysis/sampler_diag.json
# Deck stats snapshot: regenerated by mvueval_slide_stats.py from the result rows.
/analysis/slide_stats.json

# Per-question record export: rebuilt by export_question_records.py from the
# result shards plus the subset JSONs. Large, and every number in it is derived.
/analysis/records/

# Scored chart output + accuracy dumps — same rule as figs_deck above: rendered
# numbers are not published, and every one of these is rebuilt from a tracked
# script plus the (untracked) result rows.
#   crossview_out/, crossview_meva1033_out/  <- crossview_camera_curve.py --out-dir,
#                                               make_crossview_internvl_charts.py,
#                                               curate_failure_examples.py
#   crossview_*_normalized.json              <- parse_lmms_samples.py --out
#   stitch_audit_meva.png                    <- stitch_crop_audit.py
# NOTE: the charts still on disk in these two dirs are the superseded July-8
# cap-4 single-pass run; they are not comparable to anything current.
/analysis/crossview_out/
/analysis/crossview_meva1033_out/
/analysis/crossview_internvl3_normalized.json
/analysis/crossview_internvl3_meva1033_normalized.json
/analysis/stitch_audit_meva.png

# Prose: working notes, dated runbooks, reference decks, the task spec and the lit
# review — all on-disk only. The repo ships code; the write-ups live outside it.
/docs/

# Personal task lists / prompt scratchpads carrying unpublished numbers
/CLAUDE_TASKS.md
/Claude CLI Prompts*.md

# Meeting notes, transcripts and reference decks — internal, name real people,
# and carry unpublished numbers. docs/ is already ignored above; this catches
# the ones that land in the repo root (e.g. the shared multi-camera writeup).
*.pdf
/*meeting*.md
/*Meeting*.md

# Hand-saved figures and screenshots dropped at the repo root. Deck figures have
# a home under analysis/figs_deck/ (ignored above) and are rebuilt from a script;
# anything that lands loose here is a scratch export, not a tracked artifact.
/*.png

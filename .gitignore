# Python bytecode / build metadata
__pycache__/
*.py[cod]
*.egg-info/

# Incomplete downloads
*.part

# Built HF datasets (regenerable from analysis/*subset*.json)
/crossview_dataset/
*.tmp/
*.tmp

# Generated converter output: pre-subset master pools (regenerable via
# convert_crossview.py in <1s). The eval *subset* json files are tracked; these
# *_qa.json pools are not.
/analysis/crossview_*_qa.json

# AgiBot HF tar-tree cache (regenerated by fetch_agibot_videos.py)
/analysis/.agibot_tree_cache.json

# Large fetched media & external release data — licensed/regenerable, do not commit
/crossview-release-annotations/

# Regenerable analysis outputs, logs, media (rebuilt by analyze_failures.py /
# curate_failure_examples.py from the tracked eval JSONs)
/analysis/logs/

# Regenerable slide decks (binary) + eval-rerun contamination backups
*.pptx
*.contaminated*.bak

# Benchmark run outputs (regenerable via bench/run_bench.py)
/bench/results/

# Claude Code local config / runtime (per-user, not shared)
/.claude/

# eval output dumps — regenerable, outputs never in git (files stay on disk)
/Video-R1/src/r1-v/eval_results/
/lmms-eval/res/
/lmms-eval/logs/
/data/

# Regenerable deck/doc artifacts (rebuilt by make_slide_figs.py / make_repq_doc.py /
# clip_selection_diagnostic.py from tracked scripts + result rows; files stay on disk)
/analysis/figs_deck/
/analysis/repq_doc.html
/analysis/repq_doc.md
/analysis/repq_doc_manifest.json
/analysis/repq_doc_slack.txt
/analysis/sampler_diag.json

# Working notes, dated runbooks, reference decks — on-disk only. These carry
# unpublished result numbers and are deliberately kept out of the public repo.
# docs/task1_spec.md and docs/litreview_3branches.md stay TRACKED: they were
# tracked under analysis/ before the move and carry no result numbers.
/docs/MULTICAM_STATUS.md
/docs/runbooks/
/docs/reference/

# Personal task lists / prompt scratchpads carrying unpublished numbers
/CLAUDE_TASKS.md
/Claude CLI Prompts*.md
